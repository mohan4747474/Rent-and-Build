px] overflow-hidden border border-border bg-card\"><iframe title={`Google Maps location for ${selected.name}`} src={mapEmbedUrl} className=\"absolute inset-0 h-full w-full border-0\" loading=\"lazy\" referrerPolicy=\"no-referrer-when-downgrade\" /><div className=\"absolute left-3 top-3 border border-border bg-background/95 px-3 py-2 text-[10px] shadow-lg\"><b className=\"block\">{selected.name}</b><span className=\"text-muted-foreground\">{hasCoordinates ? 'Live GPS position' : `Showing ${selected.city} area`}</span><span className=\"mt-1 block text-emerald-400\">{sensor.engineStatus} · {sensor.lastSync}</span></div><div className=\"absolute bottom-3 left-3 flex items-center gap-2 border border-border bg-background/95 px-3 py-2 text-[10px] text-muted-foreground\"><MapPin size={13} className=\"text-primary\" />{hasCoordinates ? 'Vehicle position' : 'City-level position'}<span className=\"text-border\">·</span><a href={mapUrl} target=\"_blank\" rel=\"noreferrer\" className=\"font-bold text-primary hover:underline\">Open in Google Maps</a></div></div><div className=\"border border-border bg-card p-5\"><div className=\"flex items-start justify-between border-b border-border pb-4\"><div><div className=\"mono-font text-[10px] text-primary\">Selected asset</div><h3 className=\"mt-2 text-lg font-bold\">{selected.name}</h3><div className=\"mt-1 text-xs text-muted-foreground\">{selected.owner} · {selected.city}</div></div><span className=\"border border-emerald-400/30 bg-emerald-400/10 px-2 py-1 text-[10px] font-bold text-emerald-400\">{sensor.engineStatus}</span></div><div className=\"mt-5 grid gap-3 text-xs\"><div className=\"flex justify-between\"><span className=\"text-muted-foreground\">Machine type</span><b>{selected.type}</b></div><div className=\"flex justify-between\"><span className=\"text-muted-foreground\">Feed status</span><b className=\"text-emerald-400\">Connected</b></div><div className=\"flex justify-between\"><span className=\"text-muted-foreground\">GPS coordinates</span><b>{hasCoordinates ? `${sensor.latitude.toFixed(5)}, ${sensor.longitude.toFixed(5)}` : 'Waiting for GPS'}</b></div><div className=\"flex justify-between\"><span className=\"text-muted-foreground\">RPM / hydraulic</span><b>{Math.round(sensor.engineRpm)} / {sensor.hydraulicPressure.toFixed(1)} bar</b></div><div className=\"flex justify-between\"><span className=\"text-muted-foreground\">Temperature range</span><b>65–95 °C</b></div></div><button onClick={toggleEngine} className=\"mt-6 flex h-11 w-full items-center justify-center gap-2 border border-primary text-xs font-bold text-primary hover:bg-primary hover:text-primary-foreground\">{sensor.engineStatus === 'Running' ? 'STOP ENGINE PREVIEW' : 'START ENGINE PREVIEW'} <Zap size={14} /></button><div className=\"mt-4 border-l-2 border-primary bg-primary/5 p-3 text-[11px] leading-5 text-muted-foreground\">Booking and vehicle fault events appear in the notification feed. Configure SMTP/SMS providers for real delivery.</div></div></div></div></div></div></PageFrame>;\r\n}\r\n\r\nfunction OwnerShell({ children, title }: { children: ReactNode; title: string }) {\r\n  return <PageFrame><div className=\"grid lg:grid-cols-[240px_1fr]\"><aside className=\"border-b border-border bg-card p-5 lg:min-h-[calc(100dvh-72px)] lg:border-b-0 lg:border-r lg:p-6\"><div className=\"mono-font text-[10px] uppercase tracking-wider text-primary\">Owner workspace</div><h2 className=\"display-font mt-2 text-3xl font-bold uppercase\">{title}</h2><nav className=\"mt-7 grid gap-1\">{[['/owner/dashboard', 'Dashboard', LayoutDashboard], ['/owner/listings', 'My listings', ClipboardList], ['/owner/listings/new', 'Add equipment', PackagePlus], ['/fleet', 'Fleet monitoring', Radio]].map(([href, label, Icon]) => <Link key={href as string} href={href as string} className=\"flex items-center gap-3 px-3 py-3 text-xs font-semibold text-muted-foreground hover:bg-primary/10 hover:text-primary\">{typeof Icon === 'function' ? <Icon size={15} /> : null}{label as string}</Link>)}</nav></aside><section className=\"min-w-0 px-5 py-10 lg:px-10 lg:py-14\">{children}</section></div></PageFrame>;\r\n}\r\n\r\nfunction OwnerDashboardPage() {\r\n  const { equipment, bookings } = useAppState();\r\n  const { user } = useWorkspaceUser();\r\n  const ownerEquipment = equipment.filter((item) => item.ownerEmail === user?.primaryEmailAddress.emailAddress);\r\n  const ownerEquipmentIds = new Set(ownerEquipment.map((item) => item.id));\r\n  const ownerBookings = bookings.filter((booking) => ownerEquipmentIds.has(booking.equipmentId));\r\n  return <OwnerShell title=\"Owner console\"><SectionLabel eyebrow=\"Operations / 01\" title=\"One board. Every moving part.\" body=\"Manage only the equipment registered under your owner account, including its bookings and ECU-connected assets.\" /><div className=\"grid gap-3 sm:grid-cols-2 xl:grid-cols-4\">{[[String(ownerEquipment.length), 'Active listings', ClipboardList], [String(ownerBookings.length), 'Confirmed bookings', CalendarDays], [String(ownerEquipment.length), 'ECU connected', Radio], [`₹${fmt(ownerBookings.reduce((sum, booking) => sum + booking.total, 0))}`, 'Gross booked', WalletCards]].map(([value, label, Icon]) => <div key={label as string} className=\"border border-border bg-card p-5\"><div className=\"flex items-center justify-between\"><span className=\"mono-font text-2xl font-bold text-primary\">{value as string}</span>{typeof Icon === 'function' ? <Icon size={17} className=\"text-primary\" /> : null}</div><div className=\"mt-2 text-xs text-muted-foreground\">{label as string}</div></div>)}</div><div className=\"mt-8 border border-border bg-card p-5\"><div className=\"flex items-center justify-between\"><h3 className=\"text-sm font-bold\">Current work orders</h3><Link href=\"/owner/listings\" className=\"text-xs font-bold text-primary\">View listings <ArrowRight className=\"inline\" size={12} /></Link></div><div className=\"mt-4 overflow-x-auto\"><table className=\"w-full min-w