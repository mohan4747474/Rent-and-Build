`${sensor.longitude.toFixed(5)}°`], ['Speed', `${sensor.speedKph} km/h`], ['Odometer', `${sensor.odometerKm.toLocaleString('en-IN')} km`], ['Engine temperature', `${sensor.temperature} °C`], ['Engine RPM', `${sensor.engineRpm}`], ['Engine load', `${sensor.engineLoad}%`], ['Hydraulic pressure', `${sensor.hydraulicPressure} bar`], ['Work hours', `${sensor.workHours} h`], ['Fuel level', `${sensor.fuel}%`], ['Fuel rate', `${sensor.fuelRate} L/h`], ['Battery voltage', `${sensor.batteryVoltage} V`], ['Oil pressure', `${sensor.oilPressure} bar`], ['Coolant level', `${sensor.coolantLevel}%`], ['Distance today', `${sensor.kmDriven} km`], ['Engine state', sensor.engineStatus], ['Last ECU sync', sensor.lastSync]]; return <article key={item.id} className=\"border border-border bg-card p-5\"><div className=\"flex items-start justify-between\"><div><div className=\"mono-font text-[10px] text-primary\">{item.type} · {item.city}</div><h3 className=\"mt-2 font-bold\">{item.name}</h3><div className=\"mt-1 text-[10px] text-muted-foreground\">Vehicle {item.id.toUpperCase()} · ECU connected</div></div><span className=\"flex items-center gap-2 text-[10px] text-emerald-400\"><span className=\"h-2 w-2 animate-pulse rounded-full bg-emerald-400\" />Live</span></div><div className=\"mt-5 grid grid-cols-2 gap-2 text-xs\">{readings.map(([label, value]) => <div key={label} className=\"border border-border p-3\"><div className=\"text-[10px] text-muted-foreground\">{label}</div><div className=\"mono-font mt-2 font-bold text-primary\">{value}</div></div>)}</div></article>; })}</div></AdminShell>;\r\n}\r\n\r\nfunction AdminNotificationsPage() {\r\n  const { notifications } = useAppState();\r\n  return <AdminShell><SectionLabel eyebrow=\"Admin / notifications\" title=\"Dispatcher log.\" body=\"A central feed for booking, payment, location, and operation events.\" /><div className=\"border border-border bg-card\">{notifications.length ? notifications.map((item) => <div key={item.id} className=\"flex g